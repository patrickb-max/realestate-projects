{
  "name": "realestate-projects",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "functions/*",
    "database"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@reprojects/web-ui",
    "build:web": "npm run build --workspace=@reprojects/web-ui",
    "dev:core": "npm run dev --workspace=@reprojects/core-services",
    "dev:admin": "npm run dev --workspace=@reprojects/admin-services"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
